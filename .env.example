# App login — what colleagues use to open the web UI
APP_USERNAME=gepcoop
APP_PASSWORD=change_me_before_deploy

# Admin panel password (username is always "admin")
ADMIN_PASSWORD=change_me_before_deploy
BATCH_ACCESS_PASSWORD=change_me_before_deploy

# Gép-Coopilot backend flag. The buyer/admin UI also has separate visibility
# switches in ui/index.html and is intentionally hidden as of 2026-08-14.
COPILOT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase
SUPABASE_URL=
