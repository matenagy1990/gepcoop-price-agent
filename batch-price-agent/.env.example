# Supabase (same instance as GepcoopPriceAgent)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# Path to existing GepcoopPriceAgent (for importing scrapers)
PRICE_AGENT_PATH=/app/GepcoopPriceAgent

# FX rate
EUR_TO_HUF_RATE=400

# Batch limits
BATCH_MAX_ITEMS=50
BATCH_SUPPLIER_LIMIT=4
SCRAPER_TIMEOUT_SECONDS=60
SCRAPER_RETRY_COUNT=1

# Supplier credentials (same as GepcoopPriceAgent .env)
